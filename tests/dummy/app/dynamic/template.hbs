<h1 class="example-header">Dynamic Tree</h1>

<div class="sample-tree col-xs-5">
  <EmberJstree
    @themes={{this.themes}}
    @data={{this.data}}
    @plugins={{this.plugins}}
    @contextMenuReportClicked={{this.contextMenuReportClicked}}
    @eventDidBecomeReady={{this.handleTreeDidBecomeReady}}
    @eventDidMoveNode={{this.handleJstreeEventDidMoveNode}}
    @onSetupActionReceiver={{fn this.updateField "jstreeActionReceiver"}}
    @onUpdateSelectedNodes={{fn this.updateField "jstreeSelectedNode"}}
  />
</div>

<div class="info col-xs-7">
  <div class="status">
    <h2 style="margin-top:0px">Tree Status</h2>
    <p class="tree-status {{if this.treeReady "tree-ready" "tree-not-ready"}}">
      Tree Ready?
      <strong>
        {{#if this.treeReady}}
          Yes
        {{else}}
          No
        {{/if}}
      </strong>
    </p>
  </div>

  <hr/>

  <div class="selected">
    <h2>Selected Items</h2>
    {{#if this.sortedSelectedNodes}}
      <ul>
        {{#each this.sortedSelectedNodes as |node|}}
          <li><strong>{{node.text}}</strong></li>
        {{/each}}
      </ul>
    {{/if}}
  </div>

  <hr/>

  <div class="actions">
    <h2>Actions</h2>
    <button class="btn btn-default" type="button" {{on "click" this.redraw}}>Redraw</button>
    <br><br>
    <button class="btn btn-default" type="button" {{on "click" this.destroyTree}}>Destroy</button>
  </div>

</div>
